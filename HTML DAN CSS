    <!--Nurhidayah-->
    <style>
        /* Mengatur tampilan dasar halaman   */
        body {
            font-family: 'Segoe UI'; 
            margin: 20px;
            background: #96dcf6;
        }

        /* Container utama agar konten di tengah */
        .container {
            max-width: 900px;
            margin: auto;
        }

        /* Styling form */
        form {
            background: #fff;
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        /* Judul */
        h2 {
            color: #333;
        }

        /* Label form */
        label {
            font-weight: bold;
            display: block;
            margin-top: 10px;
        }

        /* Input, textarea, dan select */
        input, textarea, select {
            width: 100%;
            padding: 10px;
            margin: 5px 0 15px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }

        /* Group tombol */
        .button-group {
            display: flex;
            gap: 10px;
        }

        /* Style tombol umum */
        button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-weight: bold;
        }

        /* Hover effect */
        button:hover {
            opacity: 0.8;
        }

        /* Ukuran icon di tombol */
        button img {
            width: 18px;
            height: 18px;
        }

        /* Warna tombol */
        .submit-btn { background: #28a745; color: white; }
        .reset-btn { background: #dc3545; color: white; }
        .edit-btn { background: #ffc107; color: black; }
        .delete-btn { background: #dc3545; color: white; }

        /* Styling tabel */
        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border-radius: 10px;
            overflow: hidden;
        }

        /* Header tabel */
        th {
            background: #333;
            color: white;
            padding: 12px;
        }

        /* Isi tabel */
        td {
            padding: 12px;
            text-align: center;
        }

        /* Hover baris */
        tr:hover {
            background: #f9f9f9;
        }
    </style>
</head>

